rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E HIERARQUIA DE PERMISSÕES
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Busca o documento do usuário logado na coleção 'usuarios'
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Retorna o papel (role) do usuário logado
    function obterPapel() {
      return getUserData().papel;
    }

    // Valida se o usuário existe e está ativo no sistema
    function isUserActive() {
      return isAuthenticated() && getUserData().ativo == true;
    }

    // Hierarquia de Permissões:
    // admin possui todas as permissões de supervisor e tecnico
    function isAdmin() {
      return isUserActive() && obterPapel() == 'admin';
    }

    function isSupervisor() {
      return isUserActive() && (obterPapel() == 'supervisor' || isAdmin());
    }

    function isTecnico() {
      return isUserActive() && (obterPapel() == 'tecnico' || isSupervisor());
    }

    function isSolicitante() {
      return isUserActive() && obterPapel() == 'solicitante';
    }

    // ===============================================================
    // COLEÇÃO: USUARIOS
    // ===============================================================
    match /usuarios/{userId} {
      // Qualquer usuário autenticado pode ler perfis para exibição de nomes
      allow read: if isAuthenticated();

      // Somente administradores podem criar, alterar ou desativar usuários
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // COLEÇÃO: SETORES
    // ===============================================================
    match /setores/{setorId} {
      allow read: if isUserActive();
      allow write: if isAdmin();
    }

    // ===============================================================
    // COLEÇÃO: EQUIPAMENTOS
    // ===============================================================
    match /equipamentos/{equipamentoId} {
      allow read: if isUserActive();
      
      // Criação e exclusão por Admin, Supervisor ou Técnico (isTecnico)
      // Atualização de status por qualquer usuário ativo no fluxo de OS
      allow create, delete: if isTecnico();
      allow update: if isUserActive();
    }

    // ===============================================================
    // COLEÇÃO: ASSISTENCIAS_TECNICAS
    // ===============================================================
    match /assistencias_tecnicas/{assistenciaId} {
      // Qualquer usuário ativo pode consultar as assistências para o fluxo de Check-in
      allow read: if isUserActive();

      // Somente Administradores podem cadastrar, alterar ou remover assistências técnicas
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // COLEÇÃO: ORDENS_SERVICO
    // ===============================================================
    match /ordens_servico/{osId} {
      
      // Regra de Leitura:
      // - Admin, Supervisor e Técnico (isTecnico) podem ver todas as OS.
      // - Solicitante só pode ler as OS do seu próprio setor de lotação.
      allow read: if isUserActive() && (
        isTecnico() || 
        (isSolicitante() && resource.data.equipamento.setor_id == getUserData().setor_id)
      );

      // Regra de Criação:
      // Técnicos, Supervisores ou Admin (isTecnico) abrem a OS inicial com status 'CRIADA'
      allow create: if isTecnico() && request.resource.data.status == 'CRIADA';

      // Regra de Atualização por Etapa e Papel:
      // - Permitido para isTecnico() (edição de dados, alteração de prioridade, check-in, check-out, cancelamento)
      // - Permitido para isSupervisor() realizando soft delete (request.resource.data.deletado == true)
      // - Permitido para Solicitante no fluxo de confirmação de aceite (RETORNADA -> CONCLUIDA)
      allow update: if isUserActive() && (
        isTecnico() ||
        (isSupervisor() && request.resource.data.deletado == true) ||
        (
          ((isSolicitante() && resource.data.equipamento.setor_id == getUserData().setor_id) || isTecnico()) &&
          resource.data.status == 'RETORNADA' && 
          request.resource.data.status == 'CONCLUIDA'
        )
      );

      // Exclusão Física (Hard Delete) do banco de dados:
      // Permitido estritamente e apenas para Administradores
      allow delete: if isAdmin();
    }
  }
}
